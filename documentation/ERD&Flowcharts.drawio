ates\n\n    TEAM_MEMBERS ||--o{ EVENT_SPEAKERS : speaks_at\n    EVENTS ||--o{ EVENT_SPEAKERS : has\n\n    MEDIA ||--o{ TEAM_MEMBERS : profile_image\n    MEDIA ||--o{ EVENTS : cover_image\n    MEDIA ||--o{ SITE_CONTENT : section_image&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xD0JK3srpxSHjVl_g-pz-1">
